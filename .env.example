# Optional: canonical site origin used by sitemap, robots.txt and embed links.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: real AI replies for the site assistant.
# Leave blank and the assistant uses the built-in knowledge base (no key needed).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: POST lead submissions to a webhook (Slack, Make, Zapier, n8n, CRM).
LEADS_WEBHOOK_URL=

# Optional: Convex deployment URL for durable leads, chats, sellers and hourly history.
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional, NOT USED BY THE CODE YET: WhatToMine API token (server-side only, never NEXT_PUBLIC_*).
# Used for the ASIC list and release dates; the keyless feeds remain a fallback.
WHATTOMINE_API_KEY=

# Optional, NOT USED BY THE CODE YET: Hashrate Index (Luxor) API key for dimensions, weight, voltage and release dates.
HASHRATE_INDEX_API_KEY=
