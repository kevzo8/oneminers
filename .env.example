# Optional: real AI replies for the site assistant.
# Leave blank and the assistant uses the built-in knowledge base (no key needed).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: POST lead submissions to a webhook (Slack, Make, Zapier, n8n, CRM).
LEADS_WEBHOOK_URL=

# Optional: Convex deployment URL for durable lead / chat persistence.
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
